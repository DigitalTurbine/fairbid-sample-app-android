<?xml version="1.0" encoding="utf-8"?>
<com.fyber.fairbid.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:background="@drawable/bg_native_ad_card"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: App Icon, Headline + Advertiser, and AdChoices Container -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="10dp"
                android:contentDescription="Ad Icon"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:id="@+id/ad_choices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:minWidth="15dp"
                android:minHeight="15dp" />

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@id/ad_choices"
                android:layout_toEndOf="@id/ad_app_icon"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Ad Headline" />

            <TextView
                android:id="@+id/ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ad_headline"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:layout_toEndOf="@id/ad_app_icon"
                android:background="@color/light_gray_background"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="Ad"
                android:textColor="@color/text_color_gray_light"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ad_advertiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ad_headline"
                android:layout_marginTop="2dp"
                android:layout_toStartOf="@id/ad_choices"
                android:layout_toEndOf="@id/ad_badge"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_color_gray_light"
                android:textSize="12sp"
                tools:text="Sponsored Advertiser" />

        </RelativeLayout>

        <!-- Body text -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/black"
            android:textSize="13sp"
            tools:text="Discover incredible content with this featured native ad placement." />

        <!-- Main media view container (aspect ratio adjusted dynamically at runtime) -->
        <FrameLayout
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="@color/light_gray_background" />

        <!-- Bottom row: Rating / Store / Price and CTA button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RatingBar
                android:id="@+id/ad_stars"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5"
                android:visibility="gone"
                tools:rating="4.5"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/ad_store"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/text_color_gray_light"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Google Play"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/ad_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/text_color_gray_light"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Free"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/ad_call_to_action"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/purple_button"
                android:minWidth="80dp"
                android:paddingHorizontal="12dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:text="Install" />

        </LinearLayout>

    </LinearLayout>

</com.fyber.fairbid.ads.nativead.NativeAdView>
